<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Pasty</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Pasty</AssemblyName>
    <!-- 版本号只写这一处：程序集版本、设置页底部“关于”行、CI 的产物名与 Release 标题全部从它派生。
         发版时打一个同名的 v<版本号> 标签，GitHub Actions 会在 tag push 上直接发布。 -->
    <Version>0.1.0</Version>
    <!-- exe 自身的图标（资源管理器、任务栏、Alt+Tab）。改形状要改 tools/IconGen 里的几何再重新生成。 -->
    <ApplicationIcon>Assets\Pasty.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 三个 .ico 都要复制到输出目录：unpackaged 应用没有 ms-appx 资源，
         托盘图标用 LoadImage 从磁盘读，窗口图标走 AppWindow.SetIcon(路径)。
         Pasty.ico 同时被 ApplicationIcon 编进 exe 的资源段（那份管资源管理器/任务栏）。 -->
    <Content Include="Assets\Pasty.ico;Assets\Tray-light.ico;Assets\Tray-dark.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
</Project>
