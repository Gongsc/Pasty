<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pasty.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Pasty.Models"
    xmlns:local="using:Pasty.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="AppTitleBar" Background="Transparent">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Spacing="10" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0067C0" Offset="0" />
                                <GradientStop Color="#7A4DD6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="Pasty" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,138,0" VerticalAlignment="Center">
                <Button x:Name="ThemeButton" Click="ThemeButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE793;" FontSize="14" />
                    <ToolTipService.ToolTip>
                        <ToolTip Content="切换亮色 / 深色" />
                    </ToolTipService.ToolTip>
                </Button>
                <Button x:Name="SettingsButton" Click="SettingsButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="设置" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主体：左列表 + 右预览 -->
        <Grid Grid.Row="1" Padding="10,4,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 历史列表 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" Margin="0,4,0,8" PlaceholderText="搜索剪贴板历史…" TextChanged="SearchBox_TextChanged" />
                <ListView
                    x:Name="ItemsList" Grid.Row="1"
                    Margin="0,0,0,6"
                    SelectionMode="Single"
                    SelectionChanged="ItemsList_SelectionChanged"
                    DoubleTapped="ItemsList_DoubleTapped">
                    <ListView.Resources>
                        <DataTemplate x:Key="HeaderTemplate" x:DataType="models:HeaderRow">
                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,10,0,4" />
                        </DataTemplate>
                        <DataTemplate x:Key="ClipItemTemplate" x:DataType="models:ClipItem">
                            <Grid Margin="8,5" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="TypeIcon" Width="28" Height="28" CornerRadius="5" VerticalAlignment="Top">
                                    <TextBlock x:Name="TypeIconText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Top">
                                    <TextBlock Text="{x:Bind PreviewText, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind MetaText, Mode=OneWay}" FontSize="10.5" Opacity="0.55" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top" Opacity="0.7">
                                    <Button x:Name="EditButton" Click="EditItem_Click" Tag="{x:Bind}" Padding="5" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="编辑内容">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70F;" FontSize="12" />
                                    </Button>
                                    <Button x:Name="PinButton" Click="PinItem_Click" Tag="{x:Bind}" Padding="5" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="置顶 / 取消置顶">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="{x:Bind PinGlyph, Mode=OneWay}" FontSize="12" />
                                    </Button>
                                    <Button x:Name="DeleteButton" Click="DeleteItem_Click" Tag="{x:Bind}" Padding="5" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="删除">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74D;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                        <local:RowTemplateSelector x:Key="RowSelector"
                                                   HeaderTemplate="{StaticResource HeaderTemplate}"
                                                   ItemTemplate="{StaticResource ClipItemTemplate}" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ListViewItemPresenter
                                            ContentMargin="2,1,16,1"
                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                            SelectionCheckMarkVisualEnabled="False"
                                            PointerOverBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                                            PointerOverForeground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                            SelectedBackground="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                                            SelectedPointerOverBackground="{ThemeResource SystemControlHighlightListAccentMediumLowBrush}"
                                            PressedBackground="{ThemeResource SystemControlHighlightListMediumBrush}"
                                            SelectedPressedBackground="{ThemeResource SystemControlHighlightListAccentMediumLowBrush}"
                                            FocusVisualMargin="-3,0,-3,0"
                                            CornerRadius="6" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplateSelector>
                        <StaticResource ResourceKey="RowSelector" />
                    </ListView.ItemTemplateSelector>
                </ListView>
            </Grid>

            <Border Grid.Column="1" Width="1" Margin="10,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- 全文预览 -->
                <Grid Grid.Column="2" Margin="4,6,0,0" x:Name="PreviewArea">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="PreviewTitle" Text="全文预览" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" x:Name="PreviewActions">
                        <Button x:Name="CopyButton" Click="CopyPreview_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="13" />
                                <TextBlock Text="复制" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PasteButton" Click="PastePreview_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE77F;" FontSize="13" />
                                <TextBlock Text="粘贴" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EditPreviewButton" Click="EditPreview_Click" ToolTipService.ToolTip="编辑文字内容">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70F;" FontSize="13" />
                                <TextBlock Text="编辑" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" x:Name="EditActions" Visibility="Collapsed">
                        <Button x:Name="SaveEditButton" Click="SaveEdit_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE73E;" FontSize="13" />
                                <TextBlock Text="保存" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelEditButton" Click="CancelEdit_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE711;" FontSize="13" />
                                <TextBlock Text="取消" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" x:Name="PreviewCard" Margin="0,10,0,0" CornerRadius="10" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="16,12,6,12" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Grid>
                        <ScrollViewer x:Name="TextPreviewHost" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PreviewTextBlock" TextWrapping="Wrap" FontSize="13" LineHeight="22" IsTextSelectionEnabled="True" Margin="0,0,10,2" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="ImagePreviewHost" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="640" Margin="0,0,10,2" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="EditHost" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" MinHeight="200">
                            <TextBox x:Name="PreviewEditBox" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13"
                                     IsSpellCheckEnabled="False" BorderThickness="0" Background="Transparent"
                                     Margin="0,0,10,2" MinHeight="200" />
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyHint" Text="选择左侧条目查看完整内容" Opacity="0.5" FontSize="12" Margin="10,0,10,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock x:Name="PreviewMeta" Grid.Row="2" Margin="0,8,0,0" FontSize="10.5" Opacity="0.55" />
            </Grid>
        </Grid>
    </Grid>
</Window>
