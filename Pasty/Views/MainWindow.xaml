<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pasty.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Pasty.Models"
    xmlns:local="using:Pasty.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="AppTitleBar" Background="Transparent">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Spacing="10" VerticalAlignment="Center">
                    <!-- 与托盘/16px 应用图标同一套几何（L3，64 单位网格，见 tools/IconGen/Art.cs）。
                         Viewbox 取 22 而不是 18：图形只占网格的 48×52，这样实际显示出来才接近 18px。
                         这三个色值是品牌标记本身、不随主题变，所以刻意不走 ThemeResource。 -->
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="64" Height="64">
                            <Rectangle Canvas.Left="8" Canvas.Top="8" Width="48" Height="48"
                                       RadiusX="5" RadiusY="5" Fill="#0067C0" />
                            <Rectangle Canvas.Left="24" Canvas.Top="4" Width="16" Height="8"
                                       RadiusX="2.6" RadiusY="2.6" Fill="#8A97A5" />
                            <Path Data="M 22,26 L 32,40 L 42,26" Stroke="White" StrokeThickness="8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Pasty" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <!-- 右边距由 UpdateCaptionInset() 按 AppWindow.TitleBar.RightInset 实算，
                 这里的 138 只是首次布局完成前的兜底值 -->
            <StackPanel x:Name="TitleBarActions" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        Margin="0,0,138,0" VerticalAlignment="Center">
                <Button x:Name="ThemeButton" x:Uid="MainThemeButton" Click="ThemeButton_Click" Background="Transparent" BorderThickness="0" Padding="8"
                        AutomationProperties.Name="切换亮色 / 深色">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE793;" FontSize="14" />
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="MainThemeToolTip" Content="切换亮色 / 深色" />
                    </ToolTipService.ToolTip>
                </Button>
                <Button x:Name="SettingsButton" x:Uid="MainSettingsButton" Click="SettingsButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="14" />
                        <TextBlock x:Uid="MainSettingsText" Text="设置" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主体：左侧历史列表 + 右侧完整预览。 -->
        <Grid Grid.Row="1" Padding="10,4,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition x:Name="DividerColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 历史列表 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" x:Uid="MainSearchBox" Margin="0,4,0,8" PlaceholderText="搜索剪贴板历史…"
                         AutomationProperties.Name="搜索剪贴板历史" TextChanged="SearchBox_TextChanged" />
                <ListView
                    x:Name="ItemsList" x:Uid="MainItemsList" Grid.Row="1"
                    Margin="0,0,0,6"
                    SelectionMode="Single"
                    AutomationProperties.Name="剪贴板历史"
                    SelectionChanged="ItemsList_SelectionChanged"
                    DoubleTapped="ItemsList_DoubleTapped">
                    <ListView.Resources>
                        <!-- 行圆角。平台默认是 4，这里保持原设计的 6；
                             覆盖这个键比自己整段替换 ControlTemplate 安全得多 -->
                        <CornerRadius x:Key="ListViewItemCornerRadius">6</CornerRadius>
                        <DataTemplate x:Key="HeaderTemplate" x:DataType="models:HeaderRow">
                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,10,0,4" />
                        </DataTemplate>
                        <DataTemplate x:Key="ClipItemTemplate" x:DataType="models:ClipItem">
                            <!-- 这里的绑定都是默认的 OneTime。ClipItem 没有实现 INotifyPropertyChanged，
                                 写 Mode=OneWay 也收不到任何通知，只会让人误以为它会自动刷新。
                                 真正的刷新靠 MainWindow.UpdateGroups() 整体重建 _rows
                                 （置顶/编辑/删除/清理都会走到），容器复用时模板会重新求值。
                                 主题切换也要重建一次：图标配色与置灰文字是代码里按当前窗口主题取的。 -->
                            <Grid Margin="0,5" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- “能直接 Ctrl+V 粘”的高亮标记：文字/图片条目、且内容还在磁盘上时，
                                     行左边会出现一根主色竖条。文件条目（视频、压缩包……）没有这根条：
                                     它们只能粘到支持接收文件的应用里。内容没了的条目同样没有，
                                     并且整行会变灰、图标换成警告三角。
                                     竖条外面套了一层定宽 Grid：它一隐藏，后面的图标就会左移，行就对不齐了。 -->
                                <Grid Width="3" Margin="0,1" VerticalAlignment="Stretch">
                                    <Border CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind local:MainWindow.DirectMarkVisibility(Readiness)}" />
                                </Grid>
                                <!-- 类型标记。两套东西以前是在 ContainerContentChanging 里用
                                     Application.Current.Resources 查出来直接赋值的，而那个字典解析的是
                                     “应用”主题，绕过了本窗口的 RootGrid.RequestedTheme——手动切主题时
                                     标记颜色不跟着变。现在底色都写在 XAML 里走 ThemeResource，
                                     只由 Visibility 决定露哪一个；只有按内容类型取的那支画笔走代码
                                     （MainWindow.KindBrush 看本窗口的 ActualTheme 取色）。 -->
                                <Grid Grid.Column="1" Width="28" Height="28" VerticalAlignment="Top" Margin="10,0,0,0"
                                      ToolTipService.ToolTip="{x:Bind ReadinessHint}"
                                      AutomationProperties.Name="{x:Bind KindLabel}">
                                    <Border CornerRadius="5" Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            Visibility="{x:Bind local:MainWindow.LiveChipVisibility(Readiness)}">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="{x:Bind TypeGlyph}"
                                                  FontSize="14" Foreground="{x:Bind local:MainWindow.KindBrush(Kind)}" />
                                    </Border>
                                    <!-- 内容已经没了：图标换成警告三角，整行文字置灰 -->
                                    <Border CornerRadius="5" Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                            Visibility="{x:Bind local:MainWindow.DeadChipVisibility(Readiness)}">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7BA;"
                                                  FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Top">
                                    <!-- 标题写两份而不是绑 Foreground：WinUI 里把 Foreground 设成 null 不是
                                         “用默认色”，而是“没有画刷”——文字完全不画，只剩图标，
                                         看上去就是“历史内容全没了”。所以正常行用不带本地 Foreground 的
                                         那一份（走主题默认色），已失效的行用置灰那一份，
                                         只由 Visibility 决定露哪一个——和下面的图标同一做法。 -->
                                    <Grid>
                                        <TextBlock Text="{x:Bind PreviewText}" FontSize="12.5" TextWrapping="Wrap"
                                                   Visibility="{x:Bind local:MainWindow.LiveTextVisibility(Readiness)}"
                                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind PreviewText}" FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind local:MainWindow.DeadTextVisibility(Readiness)}"
                                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind MetaText}" FontSize="10.5" Margin="0,3,0,0"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <!-- 图标按钮的可访问名不能指望 ToolTip：ToolTipService.ToolTip 不会写
                                     AutomationProperties.Name，读屏软件念出来的是 FontIcon 里那个私用区字符。
                                     整组按钮原先用 Opacity=0.7 压暗，高对比度主题下 Opacity 照样生效，
                                     会把系统保证的对比度打掉，所以改成按图标取次级前景色。 -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                    <Button x:Name="RowActionButton" Click="RowAction_Click" Tag="{x:Bind}" Padding="5"
                                            Background="Transparent" BorderThickness="0"
                                            Visibility="{x:Bind local:MainWindow.RowActionVisibility(Type)}"
                                            AutomationProperties.Name="{x:Bind RowActionLabel}" ToolTipService.ToolTip="{x:Bind RowActionLabel}">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="{x:Bind RowActionGlyph}" FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                    <Button x:Name="PinButton" x:Uid="MainRowPin" Click="PinItem_Click" Tag="{x:Bind}" Padding="5"
                                            Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="置顶 / 取消置顶" ToolTipService.ToolTip="置顶 / 取消置顶">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="{x:Bind PinGlyph}" FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                    <Button x:Name="DeleteButton" x:Uid="MainRowDelete" Click="DeleteItem_Click" Tag="{x:Bind}" Padding="5"
                                            Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="删除" ToolTipService.ToolTip="删除">
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74D;" FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                        <local:RowTemplateSelector x:Key="RowSelector"
                                                   HeaderTemplate="{StaticResource HeaderTemplate}"
                                                   ItemTemplate="{StaticResource ClipItemTemplate}" />
                    </ListView.Resources>
                    <!-- 这里原先整段替换了 ListViewItem 的 ControlTemplate，笔刷还是 WinUI 2 时代的
                         SystemControlHighlight*：既丢掉了选中指示条与焦点框，也没有高对比度主题下的取色。
                         平台默认模板本身就把 HorizontalContentAlignment=Stretch 和各状态做好了，
                         行高由模板内 Grid 的 MinHeight + Margin 决定，因此这里不需要覆盖任何东西。 -->
                    <ListView.ItemTemplateSelector>
                        <StaticResource ResourceKey="RowSelector" />
                    </ListView.ItemTemplateSelector>
                </ListView>
                <!-- 空列表提示。以前“最近”这个分组标题是无条件加上的，
                     一条历史都没有时界面上只剩一个孤零零的标题，看着像卡在加载中。 -->
                <TextBlock x:Name="ListEmptyHint" Grid.Row="1" Visibility="Collapsed"
                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Margin="16,48,16,0" HorizontalAlignment="Center" VerticalAlignment="Top" />
            </Grid>

            <Border Grid.Column="1" Width="1" Margin="10,6"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <!-- 全文预览 -->
            <Grid Grid.Column="2" Margin="4,6,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 标题与按钮组分列，别挤在同一格里靠对齐方式错开：
                     标题变长（编辑态是“编辑内容”）时会直接压到按钮下面 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PreviewTitle" x:Uid="MainPreviewTitle" Text="全文预览" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" x:Name="PreviewActions">
                        <!-- 这几个按钮的可访问名必须显式写：内容是 StackPanel（图标 + 文字）而不是一个字符串，
                             UIA 不会从子孙 TextBlock 里聚合出 Name，读屏软件只能念出个空按钮 -->
                        <Button x:Name="CopyButton" x:Uid="MainCopyButton" Click="CopyPreview_Click" AutomationProperties.Name="复制">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="13" />
                                <TextBlock x:Uid="MainCopyText" Text="复制" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PasteButton" x:Uid="MainPasteButton" Click="PastePreview_Click" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="粘贴">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE77F;" FontSize="13" />
                                <TextBlock x:Uid="MainPasteText" Text="粘贴" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EditPreviewButton" x:Uid="MainEditButton" Click="EditPreview_Click" ToolTipService.ToolTip="编辑文字内容"
                                AutomationProperties.Name="编辑">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70F;" FontSize="13" />
                                <TextBlock x:Uid="MainEditText" Text="编辑" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" x:Name="EditActions" Visibility="Collapsed">
                        <Button x:Name="SaveEditButton" x:Uid="MainSaveButton" Click="SaveEdit_Click" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="保存">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE73E;" FontSize="13" />
                                <TextBlock x:Uid="MainSaveText" Text="保存" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelEditButton" x:Uid="MainCancelButton" Click="CancelEdit_Click" AutomationProperties.Name="取消">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE711;" FontSize="13" />
                                <TextBlock x:Uid="MainCancelText" Text="取消" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- 卡片直接铺满这一行。以前是 VerticalAlignment=Top 再由 code-behind 的
                     SizeChanged 算 MaxHeight，等于用一段代码复刻 Grid 本来就会做的事，
                     而且预览内容短时卡片会缩成一条、下面留一大片空地。 -->
                <Border Grid.Row="1" x:Name="PreviewCard" Margin="0,10,0,0" CornerRadius="10" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="16,12,6,12" HorizontalAlignment="Stretch">
                    <Grid>
                        <ScrollViewer x:Name="TextPreviewHost" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PreviewTextBlock" TextWrapping="Wrap" FontSize="13" LineHeight="22"
                                       IsTextSelectionEnabled="True" Margin="0,0,10,2" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="ImagePreviewHost" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Image x:Name="PreviewImage" x:Uid="MainImagePreview" Stretch="Uniform" MaxHeight="640" Margin="0,0,10,2"
                                   AutomationProperties.Name="图片预览" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="EditHost" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" MinHeight="200">
                            <TextBox x:Name="PreviewEditBox" x:Uid="MainPreviewEditBox" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13"
                                     IsSpellCheckEnabled="False" BorderThickness="0" Background="Transparent"
                                     AutomationProperties.Name="编辑剪贴板内容"
                                     Margin="0,0,10,2" MinHeight="200" />
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyHint" x:Uid="MainEmptyHint" Text="选择左侧条目查看完整内容" FontSize="12" Margin="10,0,10,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="MainSourceLabel" Text="来源" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="PreviewSource" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Uid="MainTypeLabel" Text="类型" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="PreviewType" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Uid="MainSizeLabel" Text="大小" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="PreviewSize" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock x:Uid="MainDateLabel" Text="日期" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="PreviewDate" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
