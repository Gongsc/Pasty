<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pasty.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar">
            <TextBlock x:Uid="AboutWindowTitle" Text="关于 Pasty" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Margin="20,8,20,20" Padding="24,20"
                CornerRadius="10" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
                <Image x:Name="AboutIcon" x:Uid="AboutIcon" Width="72" Height="72" Margin="0,0,0,2"
                       AutomationProperties.Name="Pasty 图标" />
                <TextBlock Text="Pasty" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="VersionText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <HyperlinkButton x:Uid="AboutProjectLink" Content="github.com/Gongsc/Pasty" Click="ProjectLink_Click"
                                 Padding="4,2" HorizontalAlignment="Center"
                                 AutomationProperties.Name="打开 Pasty GitHub 项目" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"
                            HorizontalAlignment="Center">
                    <Button x:Name="CheckUpdateButton" x:Uid="AboutCheckUpdate" Content="检查更新" Click="CheckUpdate_Click"
                            AutomationProperties.Name="检查更新" />
                    <Button x:Name="DownloadButton" x:Uid="AboutDownload" Content="前往下载" Click="Download_Click"
                            Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed"
                            AutomationProperties.Name="前往下载新版本" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0"
                            HorizontalAlignment="Center">
                    <ProgressRing x:Name="UpdateProgress" Width="16" Height="16" IsActive="False" />
                    <TextBlock x:Name="UpdateStatus" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
