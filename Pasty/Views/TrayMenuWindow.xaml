<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pasty.Views.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 托盘菜单与主界面的卡片共用背景、描边和圆角资源；按钮沿用 WinUI Button 的
         PointerOver/Pressed 状态，因此高亮强度也与主界面一致。根背景不能透明：
         独立 WinUI 窗口的透明区域会露出黑色交换链，切换主题后尤其明显。 -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          KeyDown="RootGrid_KeyDown">
        <Border CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Padding="6">
            <StackPanel Spacing="2">
                <Button x:Name="OpenItem" x:Uid="TrayOpen" Click="Open_Click" Height="36"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                        AutomationProperties.Name="打开面板">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8A7;" FontSize="14" />
                        <TextBlock x:Uid="TrayOpenText" Text="打开面板" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Uid="TraySettings" Click="Settings_Click" Height="36"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                        AutomationProperties.Name="设置">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="14" />
                        <TextBlock x:Uid="TraySettingsText" Text="设置" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Uid="TrayAbout" Click="About_Click" Height="36"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                        AutomationProperties.Name="关于">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;" FontSize="14" />
                        <TextBlock x:Uid="TrayAboutText" Text="关于" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Height="1" Margin="8,3"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Uid="TrayExit" Click="Exit_Click" Height="36"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                        AutomationProperties.Name="退出">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8BB;" FontSize="14" />
                        <TextBlock x:Uid="TrayExitText" Text="退出" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
